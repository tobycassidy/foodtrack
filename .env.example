# Copy to .env (or export these in your shell) before running
GEMINI_API_KEY=your_key_from_aistudio.google.com
# Flash-Lite is plenty for labels and rarely capacity-limited; gemini-3.6-flash if you want stronger estimates.
# The newest Flash (3.8 at time of writing) is often overloaded; 2.5 models are restricted to existing users.
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model returns 503 (overloaded) or 429 (rate limit)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.8-flash
# Where the SQLite file and label photos live (defaults to ./data)
FOODTRACK_DATA=./data
# How items are weighted in a meal's TCM thermal score: grams (default), kcal or equal
TCM_WEIGHTING=grams
